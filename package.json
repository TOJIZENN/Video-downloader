{
  "name": "fetchly-video-downloader",
  "version": "1.0.0",
  "description": "Self-hosted online video downloader with format picker, converters, subtitles and transcripts (powered by yt-dlp + ffmpeg).",
  "main": "server.js",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "update": "node scripts/update-engine.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "ejs": "3.1.10",
    "express": "4.22.3",
    "ffmpeg-static": "5.3.0",
    "simple-icons": "16.35.0",
    "undici": "7.30.1"
  }
}
